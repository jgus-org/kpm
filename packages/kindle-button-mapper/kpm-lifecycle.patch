+fn spawn_managed(arguments: &[&str], pid_file: &str, log_path: &str) -> (u16, String) {
+    let running = if pid_file == DAEMON_PID_FILE {
+        daemon_pid()
+    } else {
+        helper_pid()
+    };
+    if running.is_some() {
+        return if managed_pid(pid_file, arguments).is_some() {
+            (200, json_ok())
+        } else {
+            (500, json_err("a managed process is running with different arguments"))
+        };
+    }
+    let stdout = match File::options().create(true).append(true).open(log_path) {
+        Ok(file) => file,
+        Err(error) => return (500, json_err(&format!("cannot open log: {}", error))),
+    };
+    let stderr = match stdout.try_clone() {
+        Ok(file) => file,
+        Err(error) => return (500, json_err(&format!("cannot clone log: {}", error))),
+    };
+    match Command::new(INSTALLED_BINARY)
+        .args(arguments)
+        .stdin(Stdio::null())
+        .stdout(Stdio::from(stdout))
+        .stderr(Stdio::from(stderr))
+        .spawn()
+    {
+        Ok(mut child) => {
+            let deadline = Instant::now() + START_TIMEOUT;
+            while Instant::now() < deadline {
+                if managed_pid(pid_file, arguments) == Some(child.id()) {
+                    return (200, json_ok());
+                }
+                if let Ok(Some(status)) = child.try_wait() {
+                    if managed_pid(pid_file, arguments).is_some() {
+                        return (200, json_ok());
+                    }
+                    return (500, json_err(&format!("process exited with {}", status)));
+                }
+                std::thread::sleep(Duration::from_millis(25));
+            }
+            let _ = child.kill();
+            (500, json_err("process did not claim ownership"))
+        }
+        Err(error) => (500, json_err(&format!("cannot start process: {}", error))),
+    }
+}
