+pub struct PidGuard {
+    path: &'static str,
+    record: String,
+}
+
+impl Drop for PidGuard {
+    fn drop(&mut self) {
+        if fs::read_to_string(self.path).ok().as_deref() == Some(&self.record) {
+            let _ = fs::remove_file(self.path);
+        }
+    }
+}
+
+pub fn claim_daemon(config_path: &str) -> Result<PidGuard, String> {
+    if daemon_pid().is_some() {
+        return Err("a managed daemon is already running".to_string());
+    }
+    claim_process(DAEMON_PID_FILE, &[config_path])
+}
+
+fn claim_helper(config_path: &str) -> Result<PidGuard, String> {
+    if helper_pid().is_some() {
+        return Err("a managed helper is already running".to_string());
+    }
+    claim_process(HELPER_PID_FILE, &["--waf-helper", config_path])
+}
+
+fn claim_process(path: &'static str, arguments: &[&str]) -> Result<PidGuard, String> {
+    if managed_pid(path, arguments).is_some() {
+        return Err("a managed process is already running".to_string());
+    }
+    let start_time = process_start_time(process::id())
+        .ok_or_else(|| "process start time is unavailable".to_string())?;
+    let record = format!("{} {}", process::id(), start_time);
+    let temporary_path = format!("{}.{}", path, process::id());
+    let _ = fs::remove_file(&temporary_path);
+    let mut file = match File::options().write(true).create_new(true).open(&temporary_path) {
+        Ok(file) => file,
+        Err(error) => return Err(format!("cannot claim {}: {}", path, error)),
+    };
+    if let Err(error) = file.write_all(record.as_bytes()) {
+        let _ = fs::remove_file(&temporary_path);
+        return Err(format!("cannot write {}: {}", path, error));
+    }
+    drop(file);
+    if let Err(error) = fs::hard_link(&temporary_path, path) {
+        let _ = fs::remove_file(&temporary_path);
+        return Err(format!("cannot claim {}: {}", path, error));
+    }
+    let _ = fs::remove_file(&temporary_path);
+    Ok(PidGuard { path, record })
+}
+
+fn managed_pid(path: &str, arguments: &[&str]) -> Option<u32> {
+    let record = fs::read_to_string(path).ok()?;
+    let mut fields = record.split_whitespace();
+    let parsed = (
+        fields.next().and_then(|field| field.parse::<u32>().ok()),
+        fields.next().and_then(|field| field.parse::<u64>().ok()),
+        fields.next(),
+    );
+    let (Some(pid), Some(start_time), None) = parsed else {
+        let _ = fs::remove_file(path);
+        return None;
+    };
+    if process_start_time(pid) != Some(start_time) || !process_matches(pid, arguments) {
+        let _ = fs::remove_file(path);
+        return None;
+    }
+    Some(pid)
+}
+
+fn process_start_time(pid: u32) -> Option<u64> {
+    let stat = fs::read_to_string(format!("/proc/{}/stat", pid)).ok()?;
+    stat.rsplit_once(") ")?
+        .1
+        .split_whitespace()
+        .nth(19)?
+        .parse()
+        .ok()
+}
+
+fn process_matches(pid: u32, arguments: &[&str]) -> bool {
+    if fs::read_link(format!("/proc/{}/exe", pid)).ok().as_deref()
+        != Some(Path::new(INSTALLED_BINARY))
+    {
+        return false;
+    }
+    let cmdline = match fs::read(format!("/proc/{}/cmdline", pid)) {
+        Ok(value) => value,
+        Err(_) => return false,
+    };
+    let actual: Vec<&[u8]> = cmdline
+        .split(|byte| *byte == 0)
+        .filter(|field| !field.is_empty())
+        .collect();
+    actual.len() == arguments.len() + 1
+        && actual.first().copied() == Some(INSTALLED_BINARY.as_bytes())
+        && actual[1..]
+            .iter()
+            .zip(arguments)
+            .all(|(left, right)| *left == right.as_bytes())
+}
